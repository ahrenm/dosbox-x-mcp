# Generate repository-owned COM fixtures with scripts/prepare-mcp.ps1 first.
transport=named_pipe
endpoint=\\.\pipe\dosbox-mcp-fixtures
dosbox_executable=..\..\bin\x64\Agent Debug SDL2\dosbox-x.exe
dosbox_workdir=runtime-mcp
profile=test
request_timeout_ms=5000
max_message_bytes=1048576
max_memory_read_bytes=65536
max_trace_events=10000
